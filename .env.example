# Local dev (SQLite file). Use an absolute path so it resolves the same
# regardless of the process's working directory.
DATABASE_URL="file:./dev.db"

# Production (Turso). Get these from your Turso database dashboard/CLI.
# Leave TURSO_AUTH_TOKEN unset for local dev.
# DATABASE_URL="libsql://<your-db>.turso.io"
# TURSO_AUTH_TOKEN="<your-turso-token>"
